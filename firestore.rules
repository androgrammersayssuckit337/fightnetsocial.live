rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isOwner(userId);

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn();
      }
    }

    // Follows Collection
    match /follows/{followId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Posts Collection & Subcollections
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn();
      }
    }

    // Video Clips Collection
    match /videoClips/{clipId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Training Tasks Collection
    match /trainingTasks/{taskId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Contracts Collection
    match /contracts/{contractId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Sponsorship Applications Collection
    match /sponsorships/{applicationId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Network Connections Collection
    match /connections/{connectionId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Chats & Messages Subcollection
    match /chats/{chatId} {
      allow read, create, update, delete: if isSignedIn();

      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }
  }
}

